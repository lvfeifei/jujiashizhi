/* 自定义样式 */
.mar30 {
    margin: 0 30rpx;
}

.no-content {
    padding: 200rpx 0;
}

.mt25 {
    margin-top: 25rpx;
}
.ml30 {
    margin-left: 30rpx;
}
.pl30 {
    padding-left: 30rpx;
}
.ml50 {
    margin-left: 50rpx;
}

.font28 {
    font-size: 28rpx;
    font-family: PingFangSC-Regular, PingFang SC;
    font-weight: 400;
    color: #000000;
}

.pl25 {
    padding-left: 25rpx;
}

.py30 {
    padding-left: 30rpx;
    padding-right: 30rpx;
}

.common_title {
    font-size: 32rpx;
    font-family: PingFangSC-Medium, PingFang SC;
    font-weight: 600;
    color: #000000;
}

.bt_text::after {
    content: '必填';
    display: inline-block;
    width: 52rpx;
    height: 32rpx;
    line-height: 32rpx;
    text-align: center;
    background: #FBE6E5;
    border-radius: 6rpx;
    font-size: 20rpx;
    color: #DD3026;
    margin-left: 10rpx;
    vertical-align: 4rpx;
}

.text-ellipsis {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}


.multiline-ellipsis {
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    white-space: normal !important;
    word-wrap: break-word;
}



.d_flex_center {
    display: flex;
    align-items: center;
    justify-content: space-between;
}


.card_box {
    width: 100%;
    padding: 30rpx;
    background: #FFFFFF;
    box-shadow: 0 0 25rpx 0 rgba(0, 0, 0, 0.04);
    border-radius: 25rpx;
    position: relative;
}

/* 卡片区域开始 */
.card_item_box {
    margin-bottom: 30rpx;
}

.card_item_box .card_top_box .card_top_left_box .user_avatar {
    width: 90rpx;
    height: 90rpx;
    border-radius: 50%;
    margin-right: 20rpx;
}

.card_item_box .card_top_box .card_top_left_box .item_title_text {
    font-size: 34rpx;
    font-family: PingFangSC-Medium, PingFang SC;
    font-weight: 600;
    color: #000000;
}

.card_item_box .card_top_box .card_top_left_box .item_title_label {
    padding: 3rpx 12rpx;
    background: #ECEDED;
    border-radius: 8rpx;
    border: 1rpx solid #E9E9E9;
    margin-left: 20rpx;
    font-size: 26rpx;
    font-family: PingFangSC-Medium, PingFang SC;
    color: #000000;
}

.card_item_box .card_top_box .card_top_left_box .card_tiem_text {
    margin-top: 6rpx;
    font-size: 26rpx;
    font-family: PingFangSC-Regular, PingFang SC;
    color: #999;
}

.card_item_box .card_top_box .card_top_right_box .status_label_common {
    width: 113rpx;
    height: 48rpx;
    line-height: 48rpx;
    text-align: center;
    border-radius: 0 25rpx 0 25rpx;
    font-size: 26rpx;
    font-family: PingFangSC-Medium, PingFang SC;
    font-weight: 500;
    color: #FFFFFF;
    position: absolute;
    top: 0;
    right: 0;
}

.card_item_box .card_top_box .card_top_right_box .status_label_common.djs_label,
.card_item_box .card_top_box .card_top_right_box .status_label_common.djd_label {
    background: linear-gradient(135deg, #FCC13A 0%, #F88E1B 100%);
}

.card_item_box .card_top_box .card_top_right_box .status_label_common.dqr_label,
.card_item_box .card_top_box .card_top_right_box .status_label_common.dbj_label {
    background: linear-gradient(135deg, #F05E4E 0%, #DD3026 100%);
}

.card_item_box .card_top_box .card_top_right_box .status_label_common.jxz_label {
    background: linear-gradient(135deg, #14E7A5 0%, #00D0AB 100%);
}

.card_item_box .card_top_box .card_top_right_box .status_label_common.yqx_label,
.card_item_box .card_top_box .card_top_right_box .status_label_common.ywc_label {
    background: linear-gradient(125deg, #DEDEDE 0%, #C2C2C2 100%);
}



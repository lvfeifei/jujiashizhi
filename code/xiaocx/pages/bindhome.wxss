 /* ----------------------------- */
 .header_box{
  width: 100%;
  height: 140rpx; 
  padding-top: 100rpx;
}
.nav_top {
    position: fixed;
    width: 100%;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;}

.my_title{
    text-align: center;
    font-weight: 500;
}
.header_inner_box{
    display: flex;
    flex-direction: column;
    justify-content: center;

    margin-top: -15rpx;
height: 100%;
width: 750rpx;
border-radius: 18rpx 18rpx 0 0;
background-color: #ffffff;

}
.inner_box-image{
    width: 200rpx;
    height: 200rpx;
    margin:80rpx 0 0 280rpx ;
}
.inner_box-image>image{
    width: 100%;
    height: 100%;
}
.inner_box-container{
    color: #000;
    font-size: 40rpx;
    font-weight: 600;
    line-height: 70rpx;
padding: 100rpx 50rpx 0;
text-align-last: justify;
}
.inner_box-container>text{
    color:#DB3240;
}
.flex-row {
    display: flex;
    flex-direction: row;
}
.text-wrapper_6 {
    box-sizing: border-box;
    flex: 1 1 330rpx;
    padding: 22rpx 0;
    background-color: #FDE9E9;
    border-radius: 14rpx;
    height: 90rpx;
    margin-left: 20rpx;
}

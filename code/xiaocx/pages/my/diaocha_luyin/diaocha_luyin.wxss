/* pages/index/index.wxss */

 /* ----------------------------- */
 .header_box{
  width: 100%;
  height: 180rpx; 
  padding-top: 100rpx;
}

.header_inner_box {
  width: 100%; 
  padding: 30rpx;
  padding-top: 80rpx;
}

.header_title {
  font-size: 36rpx;
  font-family: PingFangSC-Regular, PingFang SC; 
  color: #FFFFFF;
}

.check_box {
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
}

.check_box .check_item_box{
    text-align: center;
    width: 328rpx; 
    background: #FFFFFF;
    border-radius: 30rpx;
    border: 2rpx solid rgba(255,255,255,0.2000);
    padding: 28rpx 24rpx;
} 

.check_item_icon {
  width: 90rpx;
  height: 83rpx;
}

.check_item_title {
  font-size: 44rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #000000;
  margin-top: -15rpx;
}

.check_item_desc {
  font-size: 30rpx;
  font-family: PingFangSC-Regular, PingFang SC; 
  color: #717274;
}

/* ----------------------------- */

.project_list_box {
  background: #fff; 
  border-radius: 20rpx 20rpx 0 0;
  margin-top: -20rpx;
  padding: 30rpx 30rpx 300rpx;
}

.tab_menu_box { 
  margin-bottom:30rpx;
}

.tab_menu_item{  
  font-size: 46rpx; 
  font-weight: bold;
  color:#000000;  
}
  
/* 案例 */
.anli_list_box {
  margin-top: 20rpx;
}

.anli_list_box .anli_item_box {
  height: 388rpx; 
  border-radius: 30rpx;
  position: relative;
  margin-bottom: 30rpx;
}

.anli_img {
  width: 100%;
  height:100%;
  border-radius: 30rpx;
}

.anli_mask {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.0400) 0%, rgba(0,0,0,0.9000) 100%); 
  border-radius: 30rpx;
}

.ali_text {
  position: absolute;
  bottom: 0;
  font-size: 40rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 56rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3000);
  padding: 25rpx;
}

.cj_label {
  width: 130rpx;
  height: 58rpx;
  line-height:58rpx;
  text-align: center;
  background: rgba(0,0,0,0.4);
  border-radius: 15rpx;
  border: 1rpx solid #FFFFFF;
  font-size: 36rpx;
  font-family: PingFangSC-Medium, PingFang SC; 
  color: #FFFFFF;
  position: absolute;
  top: 15rpx;
  left: 15rpx;
}


.qust_title {
  font-size: 40rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #000000; 
}

.answer_box {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.anwer_check_item {
  width: 48%;
  margin-right: 2%;
  height: 90rpx;
  line-height: 90rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 2rpx solid #717274; 
  font-size: 36rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #717274; 
  text-align: center;
  margin-top: 2%;
  position: relative;
}

.anwer_check_item:nth-child(2n){
  margin-right: 0;
}

.anwer_check_item.active{
  background: rgba(224,28,27,0.1000); 
  border: 2rpx solid #E01C1B;
  color: #CE0807;
}

.check_icon_2{ 
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  z-index: 10;
  top: 0;
  right: 0;
  display: none;
}

.anwer_check_item.active .check_icon_2 {
  display: block;
}

.input_item_box {
  height: 100rpx;
  background: #F7F7F7;
  border-radius: 12rpx;
  border: 2rpx solid #B7B7B7;
  width: 100%;
  padding: 0 30rpx;

}

.input_tip_text {
  font-size: 36rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #000000;
}

.quest_item {
  margin-bottom: 30rpx;
}


.down_jt_icon{
  width: 50rpx;
  height: 50rpx;
  position: absolute;
  top: 0;
  right: 0;
}

.picker_item_box {
  width: 100%;
  position: relative;
  font-size: 36rpx;
  font-family: PingFangSC-Regular, PingFang SC; 
  color: #717274;
}

.picker_width{
  width: 500rpx;
}
 
.text_area_box {  
  margin-top: 30rpx;  
  width: 100%;
  height: 180rpx;
  background: #F7F7F7;
  border-radius: 12rpx;
  border: 2rpx solid #B7B7B7;
  padding: 20rpx;
  overflow-y: auto;
}

.zgz_box {
  margin-top: 80rpx;
}



.btn_group_wrpaer{
  position: fixed;
  bottom: 0;
  width: 100%;
  z-index: 10; 
  padding: 20rpx 25rpx ; 
  background: linear-gradient(360deg, #FFF3F3 0%, #FFFFFF 100%) #FFFFFF;
  box-shadow: 0 -2rpx 20rpx 0 rgba(0,0,0,0.2);
  border-radius: 30rpx 30rpx 0 0;  
}

.btn_group_box { 
  display: flex;
  align-items: center;
  justify-content: space-between; 
}

.btn_common {
  height: 100rpx;
  line-height:100rpx;
  border-radius: 20rpx; 
  font-size: 46rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  flex: 1;
  flex-shrink: 0;
}

.btn_1 {
  background: linear-gradient(90deg, #FFEEE5 0%, #FCE7E9 100%);
  color: #D10000;
  margin-right: 20rpx !important;
}

.btn_2 {
  background: #E01C1B;
  color: #FFFFFF;
}

.btn_clean { 
  padding: 0;
  margin: 0;
}

.btn_clean::after{
  border: none; 
}

.cj_position{
  position: absolute;
  top: 15rpx;
  right: 15rpx;
}

.cj_btn_box { 
  width: 240rpx;
  height: 90rpx;
  line-height:90rpx;
  background: #E01C1B;
  box-shadow: 0 2rpx 10rpx 0 rgba(0,0,0,0.2000);
  border-radius: 20rpx;
  display: flex;
align-items: center;
justify-content: center;
}

.btn_img {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  vertical-align: middle;
}

.cj_btn_text {
  font-size: 40rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 500;
  color: #FFFFFF;
}


.dialog_content {
  text-align: center;
  padding: 40rpx;
}
.dialog_title {
  font-size: 46rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #000000;
}

.dialog_tip {
  margin-top: 20rpx;
}

.luzhi_box {
  margin-top: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding-bottom: 140rpx;
}
.start_text {
  font-size: 60rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  margin-bottom: 50rpx; 
}

.color_grey {
  color: #717274;
}
.color_black {
  color: #000000;
}

.wclz_btn,
.start_btn {
  width: 390rpx;
  height: 110rpx;
  line-height:110rpx;
}

.wclz_btn {
  background: linear-gradient(90deg, #FFEEE5 0%, #FCE7E9 100%);
}

.wclz_text {
  font-size: 46rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #CE0807;
}

.play_box {
  width: 100%;
  display: flex;
  align-items: center;
  margin-bottom: 90rpx;
}

.slider_item {
  flex: 1;
  margin: 30rpx ;
}

.start_tiem,
.end_tiem {
  font-size: 36rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #000000;
}

.ztcl_btn {
  width: 290rpx;
  height: 110rpx;
  line-height: 110rpx;
  background: linear-gradient(90deg, #FFEEE5 0%, #FCE7E9 100%);
}

.ztcl_btn_two {
  width: 220rpx;
  height: 110rpx;
  line-height: 110rpx;
  background: linear-gradient(90deg, #FFEEE5 0%, #FCE7E9 100%);
}

.mr30 {
  margin-right: 30rpx;
}

.bg_red {
  background: #E01C1B; 
} 
.color_white {
  color: #fff;
}
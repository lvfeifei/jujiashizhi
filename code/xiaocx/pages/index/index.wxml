    <view class="xieyi_dialog" wx:if="{{is_show_xieyi_dialog}}">
        <view class="xieyi_content">
            <view class="xieyi_tip">温馨提示</view>
            <view class="innder_content"> 
                <view class="xieyi_content_text text-indent">尊敬的用户，为了让您更放心的使用居家失智照护辅助系统，请您务必仔细阅读《居家失智照护辅助系统免责声明》《居家失智照护辅助系统隐私保护政策》并充分理解协议中的条款内容再点击同意，以便您能够更好的行使个人权利及保护个人信息。</view>
                <view class="xieyi_content_text text-indent" style="margin-top: 10rpx;">您点击“拒绝”协议或其中任意条款，我们将无法为您服务。</view>
                <view class="xieyi_content_text text-indent">您点击“同意”意味着您自觉遵守以上协议，本系统将严格保护您的个人信息。</view> 
 
                <view class="xieyi_bottom_box"> 
                    <view class="xieyi_article_tip">请点击以下标题，阅读完整版</view>
                    <view class="xieyi_article_box">
                        <view class="color_red xieyi_article_title" bindtap="go_xieyi" data-key="disclaimer">
                            <text>《免责声明》</text>
                            <image class="click_icon" src="../../img/click_icon.png" alt=""/>
                        </view>
                        <view class="color_red xieyi_article_title" bindtap="go_xieyi" data-key="privacy"> 
                            <text>《隐私政策》</text>
                            <image class="click_icon" src="../../img/click_icon.png" alt=""/>
                        </view>
                    </view> 
                </view>  
               
            </view> 

            <view class="xieyi_btn_group">
                <button class="xieyi_btn no_agree_btn" bindtap="no_agree_btn">拒绝</button>
                <button class="xieyi_btn agree_btn "  bindtap="agree_btn">同意</button>
            </view>

        </view> 
    </view>

 
</view>
}

.ali_small_right {
  padding: 10rpx 10rpx 10rpx 30rpx;
}
.ali_small_time{
  margin-top: 20rpx;
  font-size: 26rpx;
  font-family: PingFangSC-Regular, PingFang SC; 
  color: #000000;
  opacity: .4; 
}

image {
    width: 100%;
}

.xieyi_dialog {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, .3);
    z-index: 999; 
}

.xieyi_content {
    position: absolute;
    top: 50%;
    left: 50%;
    padding-top: 20rpx;
    background-color: #fff;
    transform: translate(-50%,-50%);
    width: 96%; 
    border-radius: 20rpx;
}

.xieyi_title {
    display: inline-block;
    text-indent:0;
}

.xieyi_tip {
    text-align: center;
    font-weight: bold;
    font-size: 46rpx;
    font-family: PingFangSC-Medium, PingFang SC; 
    color: #000000;
}

.xieyi_content_text{
    font-size: 34rpx;
    font-family: PingFangSC-Regular, PingFang SC; 
    color: #000000;
}

.innder_content {
    margin: 20rpx 0;
    padding: 0 30rpx;
}

.content_text {
    font-size: 32rpx;
    color: #666;
    margin-bottom: 10rpx;
    line-height: 1.6;
}


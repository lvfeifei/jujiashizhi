/* pages/index/index.wxss */

 /* ----------------------------- */
 page {
    padding-bottom: 150rpx;
 }
.header_box{
  width: 100%;
  /* height: 626rpx;  */
  /* height: 950rpx;  */
  padding-top: 130rpx;
}

.header_inner_box {
  width: 100%; 
  padding: 30rpx;
}

.header_title {
  font-size: 36rpx;
  font-family: PingFangSC-Regular, PingFang SC; 
  color: #FFFFFF;
}

.check_box {
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
}

.quest_one_box {
  margin-right: 25rpx;
}

 .check_item_box{
    text-align: center;
    /* width: 328rpx;  */
    background: #FFFFFF;
    border-radius: 30rpx;
    border: 2rpx solid rgba(255,255,255,0.2000);
    padding: 28rpx 24rpx;
} 

.check_item_icon {
  width: 90rpx;
  height: 83rpx;
}

.check_item_title {
  font-size: 44rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #000000;
  margin-top: -15rpx;
}

.check_item_desc {
  font-size: 30rpx;
  font-family: PingFangSC-Regular, PingFang SC; 
  color: #717274;
}

/* ----------------------------- */

.project_list_box {
  /* background: #FFFFFF;  */
  border-radius: 20rpx 20rpx 0 0;
  margin-top: -20rpx;
  padding: 30rpx 30rpx 100rpx;
  min-height: 650rpx;
}

.tab_menu_box {
  display: flex; 
  position: relative;
  z-index: 10; 
}

.tab_menu_item{ 
  text-align: center;
  position: relative; 
  margin-right: 50rpx;
  font-size: 42rpx;
  color: #717274;
}

.tab_menu_item.active {
    font-weight: bold;
    color:#000000;
}
.tab_menu_item.active::after {
  content: '';
  display: inline-block;
  width:100rpx;
  height: 14rpx;
  background: #E01C1B;
  border-radius: 7px;
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
}

 
/* 案例 */
.anli_list_box {
  margin-top: 80rpx;
}

.anli_list_box .anli_item_box {
  height: 300rpx; 
  border-radius: 30rpx;
  position: relative;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.anli_img {
  width: 100%; 
  border-radius: 30rpx;
  height: 100%;
}

.anli_mask {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.01) 0%, rgba(0,0,0,0.5) 100%); 
  border-radius: 30rpx;
}

.ali_text {
  width: 100%;
  position: absolute;
  bottom: 25rpx;
  font-size: 40rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 56rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3000);
  padding: 0 25rpx;
 
  max-height: 130rpx;
  box-sizing: border-box; 
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal !important;
  word-wrap: break-word;
  text-align: center;
}

.wtsr_box {
  margin-top: 24rpx;
  padding: 35rpx 35rpx 40rpx;
}

.wtsr_title {
  font-size: 34rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #000000;
  margin-bottom: 20rpx;
}

.wtsr_desc {
  font-size: 30rpx;
font-family: PingFangSC-Regular, PingFang SC; 
color: #717274;
}


.btn_clean { 
  padding: 0;
  margin: 0;
}

.btn_clean::after{
  border: none; 
}
 
.cj_btn_box { 
  margin-top: 38rpx;
  width: 300rpx;
  height: 85rpx; 
  line-height:  85rpx; 
  border-radius: 20px; 
  background: #E01C1B; 
  border-radius: 20rpx; 
  margin-left: auto;
  margin-right: auto;
}

.btn_img {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx; 
  vertical-align: -1rpx;
}

.cj_btn_text {
  font-size: 40rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 500;
  color: #FFFFFF;
}


.dialog_content {
  text-align: center;
  padding: 40rpx 30rpx;
}
.dialog_title {
  font-size: 46rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #000000;
}

.dialog_tip {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-family: PingFangSC-Regular, PingFang SC; 
  color: #4C4C4C;
}

.pj_btn_view {
  width: 460rpx;
  height: 100rpx;
  line-height:100rpx;
  background: #E01C1B;
  border-radius: 20rpx;
  margin: 70rpx auto 20rpx;
  font-size: 46rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;
  color: #FFFFFF;
}

.index_pj_icon {
  width: 210rpx;
  height: 210rpx; 
}

.anli_item_small_box {
  display: flex; 
  background: #FFFFFF;
  box-shadow: 0 6rpx 25rpx 0 rgba(0,0,0,0.0500);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.anli_small_img {
  width: 170rpx;
  height: 170rpx;
  border-radius: 15rpx;
  flex-shrink: 0; 
}

.ali_small_text {
  font-size: 34rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 600;

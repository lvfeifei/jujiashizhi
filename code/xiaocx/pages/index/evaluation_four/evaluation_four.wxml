<wxs module="filters" src="../../../wxs/filter.wxs"></wxs>
<view class="layout_page">
    <!-- 胶囊区域 -->
    <view class="nav_top {{fixs ? 'bg_primary' : '' }} " style="padding-top:{{top / 2}}px; line-height:{{nav_height}}px"> 

    <view class="flex_left_box" bindtap="go_back" style="line-height:{{nav_height}}px;">
      <image class="flex_left_icon" src="/static/images/header_right_icon.png" />   
    </view>   
      <view class="my_title">测评</view> 
    </view> 
 
    <view class="header_box" style="  background:url('https://jujiashizhi-1315324619.cos.ap-beijing.myqcloud.com/zixun/3831660634598.png') no-repeat; background-size: cover ;"> 
      <view class="inner_content">
        <view class="top_title_box">
          <view class="number_box">4</view>
          <view class="top_title_text">请根据老人的居住环境勾选</view>
        </view>
        <!-- <view class="bottom_title_text">请勾选近2周困扰您的问题【可多选】</view> -->
      </view>
    </view> 

    <view class="progress_box">
      <view class="progress_inner w75"> 75% </view>
    </view>

    <view class="desc_wrapper"> 
      <!-- <view class="desc_title">个人卫生</view> -->

      <view class="anli_list_box">

        <view class="anli_item_box" wx:for="{{question_list}}" wx:key="id"> 
          <view class="anli_title">{{index + 1 + '. '}}{{item.name}}</view>  
          <view class="choice_list" > 

          <block wx:for="{{item.options}}" wx:key="id"  wx:for-item="itemName"  >
            <view class="choice_item"  bindtap="click_item"  data-item="{{itemName}}"  data-pid="{{item.id}}" data-classify_id="{{item.classify_id}}"> 
                <image class="anli_check_img" src="/static/images/{{filters.check_item_one_arr(question,itemName) ? 'check_1' : 'no_check_1'}}.png" /> 
                <text class="choice_item_text">{{itemName.name}}</text> 
            </view>  
            <input wx:if="{{filters.check_item_is_auther(question,itemName)}}" bindinput="set_auther_content"  data-auther_id="{{itemName.id}}" class="auther_input" type="text" placeholder="请填写其他内容"/>  
          </block>
            

           </view>  
        </view>

        
         
      </view>
       

    </view>
 
   <view class="btn_group_wrpaer">
    <view class="btn_group_box">
        <button class="btn_clean btn_common btn_1" bindtap="go_back" hover-class="btn_hover">上类问题</button>
        <button class="btn_clean btn_common btn_2" bindtap="go_next"  hover-class="btn_hover" >提交</button>
      </view> 
   </view>
 
  </view> 